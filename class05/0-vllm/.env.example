# Copia este archivo a .env (en la misma carpeta que docker-compose.yml) y
# ajusta los valores antes de correr `docker compose up -d`.

# Modelo a servir. Por defecto un modelo abierto SIN gating (no requiere
# HF_TOKEN ni aceptar licencia en Hugging Face) — bueno para empezar:

# Solo necesario si MODEL_ID es un modelo con licencia (gated). Genera un
# token de lectura en https://huggingface.co/settings/tokens
HF_TOKEN=

# para Qwen

#MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Alternativas para el ejercicio (requieren HF_TOKEN y haber aceptado la
# licencia del modelo en huggingface.co/<modelo> con tu cuenta):
# MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# MODEL_ID=google/gemma-2-9b-it

# Cuánto contexto soporta el modelo servido (ajusta según memoria de la GPU;
# L4 tiene 24GB — 8192 es un valor conservador para modelos de 7-9B).
MAX_MODEL_LEN=8192

# Fracción de memoria de GPU que vLLM puede reservar (0.0-1.0).
#GPU_MEMORY_UTILIZATION=0.90

# Para GPT-OSS:
MODEL_ID=openai/gpt-oss-20b
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.55

# API key "falsa" que Open WebUI exige para la conexión OpenAI-compatible.
# vLLM no la valida — puede ser cualquier string.
OPENAI_API_KEY=sk-si7016-lab-local


